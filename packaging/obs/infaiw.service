[Unit]
Description=infaiw server

[Service]
ExecStart=/usr/bin/infaiw server
WorkingDirectory=%h
EnvironmentFile=-%h/.config/infaiw/server.env
# The user manager does not read shell startup files, so its PATH lacks the
# user's ~/.local/bin, where a native Claude Code install lives. Add it here so
# the server, and the commands it runs, can find the tools the user can.
# %h is systemd's specifier for the user's home directory.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
# Delegate the cgroup subtree so the server can bound each Claude Code CLI call
# it spawns, without the server running as root. DelegateSubgroup keeps the
# unit's own cgroup empty; cgroup v2 refuses to enable controllers for children
# of a cgroup that holds processes. Requires systemd 254 or newer.
Delegate=yes
DelegateSubgroup=supervisor

[Install]
WantedBy=default.target
